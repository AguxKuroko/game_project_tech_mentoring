# Copy this file to .env and fill in your own values.
# DO NOT commit your real .env — it is gitignored.

# RAWG API — get a free key at https://rawg.io/apidocs
RAWG_API_KEY=your_rawg_api_key_here

# OpenAI API — get one at https://platform.openai.com/api-keys
# Note: image generation costs real money per call.
OPEN_AI_API_KEY=your_openai_api_key_here

# Backend API key — protects this API from random callers on the internet.
# Generate any long random string. Suggested command:
#   poetry run python -c "import secrets; print(secrets.token_urlsafe(32))"
# Use the SAME value here AND in your Streamlit frontend config,
# so the backend and frontend agree on the shared secret.
BACKEND_API_KEY=any_long_random_string_you_generate

# Logfire observability token — required by the logger config.
# Get one at https://logfire.pydantic.dev (free tier available).
LOGFIRE_TOKEN=your_logfire_token_here

# DB_DIR — where the SQLite DB + generated memes are stored.
# Leave unset locally; defaults to app/db inside the repo.
# Set this only when the storage path needs to point at a mounted volume
# (e.g. Fly.io persistent volume, or a Docker bind mount) so data survives restarts.
# On Fly.io this is already wired up in fly.toml — you don't need to set it manually.
# DB_DIR=/data
